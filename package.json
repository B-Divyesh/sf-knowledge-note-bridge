{
  "name": "knowledge-note-bridge-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "cargo test && cargo build --release && node --test site/src/demo-core.test.js && node scripts/validate-claims.mjs && npm run build:site && npm run test:e2e",
    "test:claims": "npm run build && playwright test --project=claims",
    "test:site": "node --test site/src/demo-core.test.js",
    "build:site": "vite build && node scripts/build-service-worker.mjs",
    "build": "cargo build --release && npm run build:site",
    "preview": "node scripts/serve-site.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "22.10.2",
    "vite": "6.4.3"
  }
}
